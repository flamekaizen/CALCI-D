{
  "name": "calci-desktop",
  "version": "1.0.0",
  "description": "Calci — all-in-one advanced calculator for Windows, macOS and Linux.",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "sync:web": "node scripts/sync-web.mjs",
    "dev": "node scripts/sync-web.mjs && electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flamekaizen/CALCI-D.git"
  },
  "keywords": [],
  "author": "flamekaizen",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/flamekaizen/CALCI-D/issues"
  },
  "homepage": "https://calci-web.vercel.app",
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@45.3.1": true,
    "electron-winstaller@5.4.0": true
  },
  "productName": "Calci",
  "private": true,
  "build": {
    "appId": "io.github.flamekaizen.calci.desktop",
    "productName": "Calci",
    "copyright": "Copyright © 2026 flamekaizen",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "app/**/*",
      "package.json",
      "!app/.synced"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Calci",
      "artifactName": "Calci-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Calci-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon-1024.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education;Science;Math;Utility",
      "icon": "build/icon-1024.png",
      "maintainer": "flamekaizen"
    }
  }
}
